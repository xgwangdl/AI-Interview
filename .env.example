# Copy to .env and fill in the secrets. Never commit the real .env.

# --- Database (pgvector) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/interview
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
POSTGRES_DB=interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# 启动时是否执行 Flyway 迁移
PRACTICE_FLYWAY_ENABLED=true

# --- Redis (analysis job queue / state) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Media storage: local | s3 ---
MEDIA_PROVIDER=local
MEDIA_STORAGE_DIR=./data/media
MEDIA_RETENTION_DAYS=7
MEDIA_SIGNED_URL_TTL_SECONDS=300
# 单次上传与请求体上限（同时约束每题录像大小）
MEDIA_MAX_FILE_SIZE=250MB
MEDIA_MAX_REQUEST_SIZE=250MB

# --- S3-compatible storage (used when MEDIA_PROVIDER=s3) ---
# 开发环境默认服务是 adobe/s3mock（端口 9090），凭证不做校验，填任意值即可。
# 换成真实 MinIO / S3 时只改 endpoint 与凭证。
MEDIA_S3_ENDPOINT=http://localhost:9090
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=light-interview-media
MEDIA_S3_ACCESS_KEY=test
MEDIA_S3_SECRET_KEY=test
MEDIA_S3_PATH_STYLE=true
S3_API_PORT=9090

# --- Alibaba DashScope (chat / ASR / TTS / image) ---
Ali_API_KEY=

# --- Auth ---
AUTH_TOKEN_SECRET=change-this-development-secret
# 同一用户名连续登录失败超过阈值后锁定一段时间
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_LOCK_WINDOW_MINUTES=15

# --- Analysis pipeline ---
PRACTICE_ANALYSIS_MAX_ATTEMPTS=3
PRACTICE_ANALYSIS_PROVIDER_TIMEOUT_MS=120000
PRACTICE_ANALYSIS_POLL_INTERVAL_MS=15000
PRACTICE_ANALYSIS_INITIAL_DELAY_MS=30000
# 失败重试的指数退避：第 n 次失败后等 基数 × 2^(n-1)，封顶 max
PRACTICE_ANALYSIS_RETRY_BACKOFF_MS=5000
PRACTICE_ANALYSIS_RETRY_BACKOFF_MAX_MS=300000
# 转写 / 评分供应商：dashscope + spring-ai 为真实实现；都设为 stub 可在没有云端凭证时跑通全流程
PRACTICE_ASR_PROVIDER=dashscope
PRACTICE_EVALUATION_PROVIDER=spring-ai

# --- Interviewer avatar ---
PRACTICE_AVATAR_PROVIDER=local-2d
PRACTICE_AVATAR_TTS_ENABLED=true
PRACTICE_AVATAR_VOICE=sambert-zhixiang-v1

# --- Mail (resume invitations) ---
USER_NAME=
PASS_WORD=

# --- Server ---
SERVER_PORT=8088

# --- 代码沙箱（笔试模块）---
# 会在本机 Docker 里执行用户提交的代码，默认关闭，只在本机开发环境打开。
# 打开前请确认：机器可控、不对公网暴露；执行参数见 CodeRunnerService 的注释。
CODE_RUNNER_ENABLED=false
CODE_RUNNER_MAX_CONCURRENCY=2
CODE_RUNNER_COMPILE_TIMEOUT_SECONDS=10
CODE_RUNNER_RUN_TIMEOUT_SECONDS=5
CODE_RUNNER_MEMORY_MB=256

# --- ffmpeg (video -> wav extraction for ASR) ---
# FFMPEG_PATH=C:\software\ffmpeg-7.1-full_build\bin\ffmpeg.exe
# FFMPEG_TIMEOUT_SECONDS=60
