{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeData",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "document_type", "person", "headline", "summary", "skills", "experience", "education", "projects", "portfolio", "certifications", "languages", "notes"],
  "properties": {
    "language": {"enum": ["zh", "en", "ja"]},
    "document_type": {"enum": ["resume", "cv", "career_history"]},
    "generated_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"},
    "target_role": {"type": ["string", "null"]},
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reading", "location", "phone", "email", "links"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reading": {"type": ["string", "null"]},
        "location": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"], "format": "email"},
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri"}}
          }
        }
      }
    },
    "headline": {"type": "string", "minLength": 1},
    "summary": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "items"],
        "properties": {"label": {"type": "string"}, "items": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "company", "role", "bullets"],
        "properties": {
          "start": {"type": "string"},
          "end": {"type": "string"},
          "company": {"type": "string"},
          "role": {"type": "string"},
          "bullets": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "institution", "field"],
        "properties": {
          "start": {"type": "string"},
          "end": {"type": "string"},
          "institution": {"type": "string"},
          "field": {"type": "string"}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "name", "role", "bullets"],
        "properties": {
          "start": {"type": ["string", "null"]},
          "end": {"type": ["string", "null"]},
          "name": {"type": "string"},
          "role": {"type": "string"},
          "bullets": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "url"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": ["string", "null"]},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "issuer", "date"],
        "properties": {
          "name": {"type": "string"},
          "issuer": {"type": ["string", "null"]},
          "date": {"type": ["string", "null"]}
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "level"],
        "properties": {"language": {"type": "string"}, "level": {"type": "string"}}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
